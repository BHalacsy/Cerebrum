{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@earendil-works/*": ["./install/releases/1.4.0/node_modules/@earendil-works/*"]
    },
    "typeRoots": ["./install/releases/1.4.0/node_modules/@types"],
    "types": ["node"]
  },
  "include": ["extensions/**/*.ts"]
}
