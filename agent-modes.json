				{
					"agent": "explore"
				},
				{
					"agent": "plan",
					"gate": true
				},
				{
					"agent": "build",
					"permissions": {
						"bash": {
							"git commit*": "deny",
							"git push*": "deny",
							"git tag *": "deny",
							"gh pr create*": "deny",
							"glab mr create*": "deny",
							"npm publish*": "deny"
						}
					},
					"instructions": "Do not commit or push \u2014 the ship phase does that."
				},
				{
					"agent": "review",
					"onReject": {
						"goto": "build",
						"max": 3
					}
				},
				{
					"agent": "test",
					"onReject": {
						"goto": "build",
						"max": 3
					},
					"permissions": {
						"bash": {
							"git commit*": "deny",
